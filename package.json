{
  "name": "bb-estudos",
  "version": "1.0.0",
  "description": "Estudos para o concurso do Banco do Brasil com questões geradas e auditadas por IA",
  "scripts": {
    "dev": "concurrently -n api,site -c yellow,cyan \"tsx watch src/server.ts\" \"npm --prefix web run dev\"",
    "build": "npm --prefix web run build",
    "start": "tsx src/server.ts",
    "bb": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit && npm --prefix web exec tsc -- --noEmit",
    "setup": "npm install && npm --prefix web install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.3.0",
    "mathjs": "^15.2.0",
    "mongoose": "^9.11.2",
    "openai": "^7.32.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
