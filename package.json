{
  "name": "bb-estudos",
  "version": "1.0.0",
  "description": "Estudos para o concurso do Banco do Brasil com questões geradas e auditadas por IA",
  "scripts": {
    "dev": "concurrently -n api,site -c yellow,cyan \"tsx watch src/server.ts\" \"npm --prefix web run dev\"",
    "build": "npm --prefix web run build",
    "start": "node --import tsx src/server.ts",
    "bb": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lighthouse": "lighthouse http://localhost:5181/#painel --form-factor=mobile --only-categories=performance,accessibility,best-practices --chrome-flags=--headless=new --view",
    "test": "tsx --test \"shared/**/*.test.ts\" \"src/**/*.test.ts\"",
    "smoke": "tsx scripts/smoke.ts",
    "setup": "npm install && npm --prefix web install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mathjs": "^15.2.0",
    "mongoose": "^9.11.2",
    "openai": "^7.32.0",
    "tsx": "^4.23.15",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "lighthouse": "^13.5.0",
    "mongodb-memory-server": "^11.3.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "22.x"
  },
  "type": "module"
}
