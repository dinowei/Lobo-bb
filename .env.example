MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/bb-estudos

# Chave da NVIDIA: build.nvidia.com/settings/api-keys (começa com nvapi-)
# Use "npm run bb -- modelos --filtro nemotron" para ver os ids exatos disponíveis.

# Gerador (rápido/barato) — ex.: um Nemotron menor
GERADOR_BASE_URL=https://integrate.api.nvidia.com/v1
GERADOR_API_KEY=nvapi-
GERADOR_MODEL=

# Auditor (o mais forte que você tiver; precisa ser DIFERENTE do gerador)
# Também extrai as provas e escreve as explicações das oficiais
AUDITOR_BASE_URL=https://integrate.api.nvidia.com/v1
AUDITOR_API_KEY=nvapi-
AUDITOR_MODEL=nvidia/nemotron-3-super-120b-a12b

# Embeddings (busca nas fontes e classificação por tópico)
EMBED_BASE_URL=https://integrate.api.nvidia.com/v1
EMBED_API_KEY=nvapi-
# 2048 dimensões (o llama-3.2-nv-embedqa-1b-v2 foi desativado em 05/2026)
EMBED_MODEL=nvidia/nemotron-3-embed-1b
# opcional: reduzir dimensões, só em modelos que aceitam (o nemotron-3-embed-1b só aceita 2048)
EMBED_DIMENSOES=
# "npm run bb -- testar" mostra o valor certo
EMBED_DIM=
# 1 para modelos da NVIDIA que exigem input_type (query/passage)
EMBED_INPUT_TYPE=1
# Similaridade mínima para ligar um trecho a um tópico (ajuste se sobrar trecho órfão)
EMBED_MIN_SIM=0.3

VECTOR_INDEX=chunks_vector

# Servidor
PORT=3333
# App pessoal: id fixo do aluno (24 caracteres hexadecimais)
ALUNO_ID=000000000000000000000001

# Tokens extras por chamada para o "pensamento" dos modelos de raciocínio (Nemotron 3+)
LLM_RESERVA_RACIOCINIO=16000
# Teto absoluto de tokens por chamada (corta raciocínio sem fim)
LLM_TETO_TOKENS=24000
# Tempo máximo de cada chamada de IA, em segundos (depois disso tenta de novo: 2s, 6s, 18s)
LLM_TIMEOUT_SEG=180
# 0 desliga o "pensamento" do modelo (Nemotron). Gerador sem pensar fica rápido; o auditor continua pensando.
GERADOR_PENSAR=1
AUDITOR_PENSAR=1
# Limite de tokens de "pensamento" por chamada (reasoning_budget da NVIDIA)
GERADOR_RACIOCINIO=6000
AUDITOR_RACIOCINIO=8000
# Auditor de reserva: usado quando o principal falha (fora do ar, timeout, sem JSON)
AUDITOR_MODEL_RESERVA=nvidia/nemotron-3-ultra-550b-a55b
# Escritor das frases de Português por construção (modelo DIFERENTE do auditor; usa a chave do GERADOR)
ESCRITOR_PT_MODEL=z-ai/glm-5.3-flash
ESCRITOR_PT_MODEL_RESERVA=deepseek-ai/deepseek-v4.1-flash

# Teto de gerações de questão por dia (cada tentativa conta, aprovada ou não; o noturno tem os seus)
GERACAO_MAX_DIA=60
# De dia o app só usa o que está pronto; 1 religa a geração sob demanda
GERACAO_DE_DIA=0
# Noturno (adendo do banco grande): para no que vier primeiro
GERACAO_MAX_TENTATIVAS_NOITE=200
META_APROVADAS_NOITE=100
EXPLICACOES_NOITE=40
AULAS_NOITE=10
CARTOES_NOITE=6
FONTES_ATUAIS_NOITE=20
# voz do Binho (NVIDIA Magpie TTS, API hospedada); a chave pode ser a mesma nvapi- do gerador
NVIDIA_TTS_API_KEY=
NVIDIA_TTS_FUNCTION_ID=
NVIDIA_TTS_VOZ=
VOZ_NOITE=40
VOZ_NA_HORA_MAX_DIA=40
# caminho do ffmpeg se ele não estiver no PATH (converte o WAV da NVIDIA para MP3)
FFMPEG_PATH=
CARTOES_NOVOS_DIA=20
EXPLICACOES_MAIS_MAX_DIA=20
META_BANCO=1200
META_TEMAS_REDACAO=40
NOTURNO_TRABALHADORES=3
NOTURNO_ESPERAS_MIN=10,30,90
# Limite global de pedidos por minuto à NVIDIA (todos os trabalhadores juntos)
NVIDIA_RPM_MAX=30
# Filtro anti-repetição (cosseno do embedding de enunciado + correta; trechos = Jaccard de 4 palavras)
# Calibragem: npm run bb -- similaridade calibrar → docs/CALIBRAGEM-SIMILARIDADE.md
SIMILAR_DUPLICADA=0.97
SIMILAR_PARECIDA=0.93
SIMILAR_OFICIAL=0.93
SIMILAR_JACCARD=0.6
